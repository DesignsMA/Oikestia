# ============================================================
# Oikestia — variables de entorno
# Copia este archivo como .env.local (web) y rellena los valores.
# NUNCA commites el archivo con valores reales.
# ============================================================

# --- Conexión a MongoDB (web y dashboard) ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=oikestia

# --- Cifrado ---
# Clave AES-256 de 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Secreto para firmar sesiones y tokens internos. Generar igual que arriba.
SESSION_SECRET=

# Secreto compartido para el traspaso de sesión Next -> Dash
DASH_HANDOFF_SECRET=

# --- URLs públicas ---
APP_PUBLIC_URL=http://localhost:3000
DASH_PUBLIC_URL=http://localhost:8050

# --- OSM (políticas de uso) ---
# Nominatim exige identificar la app: pon un correo real en producción.
NOMINATIM_CONTACT_EMAIL=
# Instancia propia opcional; por defecto la pública de OpenStreetMap.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Desactiva la geocodificación de direcciones al publicar (pruebas sin red).
GEOCODER=on
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Correo transaccional (Resend, Brevo u otro) ---
EMAIL_API_KEY=
EMAIL_FROM="Oikestia <no-reply@oikestia.com>"

# --- Desarrollo ---
# Marca propietarios como verificados automáticamente (SOLO desarrollo)
DEV_AUTO_VERIFY=false

# Cookie de sesión con flag Secure (true tras proxy HTTPS en producción)
COOKIE_SECURE=false

# --- Límites de imágenes ---
MAX_UPLOAD_MB=8
MAX_IMAGES_PER_LISTING=20
